<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.samflow.server</string>

    <!-- Keeps the Whisper model warm and mmap'd. Cold a dictation costs ~11s,
         warm ~0.5s. install.sh fills in the @@...@@ placeholders. -->
    <key>ProgramArguments</key>
    <array>
        <string>@@WHISPER_SERVER@@</string>
        <string>-m</string>
        <string>@@SAMFLOW_DIR@@/models/ggml-large-v3-turbo-q8_0.bin</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8181</string>
        <string>-l</string>
        <string>@@LANGUAGE@@</string>
        <string>-t</string>
        <string>8</string>
        <!-- beam search i.p.v. greedy: nauwkeuriger, kost ~50ms (ruim binnen budget) -->
        <string>-bs</string>
        <string>5</string>
        <!-- woordenlijst de hele opname blijven meesturen, niet alleen het begin -->
        <string>--carry-initial-prompt</string>
        <!-- Spraakdetectie vóór de transcriptie. Zonder dit gaat achtergrondgeluid
             (radio, muziek) gewoon naar het model, en dat vérzint er dan tekst bij:
             gemeten met een radio aan en een zwijgende spreker gaf dezelfde 6 seconden
             drie keer een ánder verzinsel ('*repeat*', 'Gov. Gov. Gov.', 'Tja, Tja').
             De hallucinatie-lijst in cleanup.py wint dat nooit -- het is geen vaste
             string. VAD lost het bij de bron op: geen spraaksegment, geen transcriptie.
             Kost +0,08s op een echt dictaat en scheelt 1,3s op puur achtergrondgeluid
             (0,03s i.p.v. 1,37s, want het model draait dan helemaal niet). Gemeten:
             dictaten mét radio op de achtergrond komen er onveranderd uit. -->
        <string>--vad</string>
        <string>-vm</string>
        <string>@@SAMFLOW_DIR@@/models/ggml-silero-v5.1.2.bin</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@@HOME@@/Library/Logs/samflow-server.log</string>
    <key>StandardErrorPath</key>
    <string>@@HOME@@/Library/Logs/samflow-server.log</string>
</dict>
</plist>
